#!/usr/bin/env python3
"""Fake ffmpeg for vidsummarizer E2E tests (shadowed onto PATH by tests).

`-version` prints a version line (used by doctor); conversion mode writes a
placeholder file at the output path (its bytes are never inspected because
the fake whisper-cli accepts any .wav).
"""
import json
import os
import sys
from pathlib import Path

argv = sys.argv[1:]

log = os.environ.get("YT_FAKE_LOG")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps({"tool": "ffmpeg", "argv": argv}) + "\n")

if "-version" in argv:
    print("ffmpeg version 7.1.1-fake Copyright (c) fake")
    sys.exit(0)

Path(argv[-1]).write_bytes(b"RIFFfake-wav-bytes")
sys.exit(0)
